// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



// --------------------------------------
// ENUMS (Opciones fijas)
// --------------------------------------

enum Role {
  SUPER_ADMIN // Tú (Gestor de todo el software)
  ADMIN       // Tu papá (Administrador de su mueblería)
  SELLER      // Los vendedores
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum InvoiceStatus {
  PAID
  PENDING
  CANCELLED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  DEPOSIT
  WITHDRAWAL
  EXPENSE
}

// --------------------------------------
// MODELO SAAS (EL SECRETO PARA VENDER EL SOFTWARE)
// --------------------------------------

// Cada "Tenant" es una empresa cliente (Ej: "Muebles Mamá", "Mueblería Pérez")
model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // Para la url del catalogo: miapp.com/catalogo/muebles-mama
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Super Admin Control
  isBanned    Boolean  @default(false) // Si el negocio está baneado
  bannedAt    DateTime? // Fecha en que se baneó
  
  // Configuración del Catálogo Público
  catalogDescription  String?  // Descripción que aparece en el catálogo
  catalogBgColor      String   @default("#f5f5f4") // Color de fondo del catálogo
  catalogAccentColor  String   @default("#292524") // Color de acento (encabezado, botones)
  catalogEnabled      Boolean  @default(true) // Si el catálogo está activo
  catalogWhatsApp     String?  // Número de WhatsApp para consultas directas
  
  // Configuración de zona horaria (IANA, ej: 'America/Bogota')
  timezone            String   @default("America/Bogota")
  
  // Relaciones: Todo lo de abajo pertenece a un Tenant
  users       User[]
  products    Product[]
  warehouses  Warehouse[]
  customers   Customer[]
  invoices    Invoice[]
  categories  Category[]
  suppliers   Supplier[]
  cashShifts  CashShift[]
  expenses    Expense[]
  purchases   Purchase[]
  purchasePayments PurchasePayment[]
  stockBatches StockBatch[]
  auditLogs   AuditLog[]
  tenantSequences TenantSequence[]
  // Backups
  backupConfig BackupConfig?
  
  // Código de registro usado para crear este tenant
  registrationCodeId String?
  registrationCode   RegistrationCode? @relation(fields: [registrationCodeId], references: [id])
}

model BackupConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  
  googleEmail       String?  // Correo del Drive conectado
  refreshToken      String?  // Token para renovar acceso sin pedirlo cada vez
  targetFolderId    String?  // ID de la carpeta en Google Drive
  
  isEnabled         Boolean  @default(false)
  autoBackupEnabled Boolean  @default(true)
  lastBackupAt      DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GlobalBackupConfig {
  id                String   @id @default("global-config")
  
  googleEmail       String?
  refreshToken      String?
  targetFolderId    String?  // Carpeta raíz de los backups globales
  
  isEnabled         Boolean  @default(false)
  lastBackupAt      DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// --------------------------------------
// CÓDIGOS DE REGISTRO (SUPER ADMIN)
// --------------------------------------

model RegistrationCode {
  id          String    @id @default(uuid())
  code        String    @unique
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  
  // Tenant que usó este código
  tenants     Tenant[]
  
  @@index([code])
}

// --------------------------------------
// USUARIOS Y SEGURIDAD
// --------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Recuerda hashear la contraseña (bcrypt)
  name      String
  role      Role     @default(SELLER)
  
  // Multi-tenancy
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  // Asignación de almacén (Opcional, principalmente para SELLER)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // Relaciones
  sales     Invoice[] // Las ventas que ha hecho este usuario
  cashShifts CashShift[]
  expenses  Expense[] // Gastos registrados por este usuario
  stockMovements StockMovement[] // Movimientos de inventario realizados
  purchases   Purchase[]
  purchasePayments PurchasePayment[]

  @@index([tenantId])
  @@index([warehouseId])
}

// --------------------------------------
// INVENTARIO Y PRODUCTOS
// --------------------------------------

model Category {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  barcode     String?  // Aquí escaneas el código de barras
  sku         String?  // Código interno
  images      String[] @default([]) // Array de URLs (Max 3)
  
  // Precios (Usamos Decimal para evitar errores de dinero)
  costPrice   Decimal  @default(0) // Cuanto le costó a tu mamá (Privado)
  salePrice   Decimal  @default(0) // Precio al público
  
  isPublic    Boolean  @default(true) // Si false, no sale en el catálogo web
  active      Boolean  @default(true) // Para Soft-Delete

  // Multi-tenancy
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  // Relaciones
  inventory   Stock[]       // Relación con almacenes
  invoiceItems InvoiceItem[]
  stockMovements StockMovement[] // Kardex del producto

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Un código de barras debe ser único SOLO dentro de la misma empresa
  @@unique([barcode, tenantId]) 
  @@index([tenantId])
  purchaseItems PurchaseItem[]
  stockBatches  StockBatch[]
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String   // Ej: "Bodega Principal", "Sala de Ventas Centro"
  address   String?
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  // Inventario en este almacén específico
  stocks    Stock[]

  // Usuarios asignados a este almacén
  users     User[]

  isDefault Boolean  @default(false)
  
  stockMovements StockMovement[] // Movimientos en este almacén
  stockBatches    StockBatch[]

  @@index([tenantId])
}

// TABLA PIVOTE: Relaciona Producto con Almacén y guarda la cantidad
model Stock {
  id          String    @id @default(uuid())
  quantity    Int       @default(0)
  
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // Es buena práctica poner una restricción única para no duplicar filas
  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// --------------------------------------
// KARDEX - MOVIMIENTOS DE INVENTARIO
// --------------------------------------

enum StockMovementType {
  PURCHASE      // Entrada por compra
  SALE          // Salida por venta
  TRANSFER_IN   // Entrada por transferencia
  TRANSFER_OUT  // Salida por transferencia
  ADJUSTMENT    // Ajuste manual (positivo o negativo)
  RETURN        // Devolución de cliente
  DAMAGE        // Merma por daño
  INITIAL       // Stock inicial
}

model StockMovement {
  id            String            @id @default(uuid())
  quantity      Int               // Positivo = entrada, Negativo = salida
  balanceAfter  Int               // Saldo después del movimiento
  type          StockMovementType
  reference     String?           // Número de factura, orden de compra, etc.
  notes         String?           // Notas adicionales
  
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  
  // Opcional: Usuario que hizo el movimiento
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  
  createdAt     DateTime          @default(now())
  
  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([type])
}

// --------------------------------------
// FACTURACIÓN Y CLIENTES
// --------------------------------------

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  docNumber String?   // Cédula o NIT
  
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  
  invoices  Invoice[]
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   Int           // Consecutivo por tenant (1, 2, 3...)
  total           Decimal
  discount        Decimal       @default(0)
  status          InvoiceStatus @default(PAID)
  paymentMethod   PaymentMethod
  
  // Fechas (Importante para que tu papá vea el flujo diario)
  createdAt       DateTime      @default(now()) 
  
  // Relaciones
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  
  sellerId        String
  seller          User          @relation(fields: [sellerId], references: [id]) // Quién vendió
  
  // Almacén del que se descontó el stock (necesario para revertir al cancelar)
  warehouseId     String?
  
  amountReceived  Decimal?
  amountReturned  Decimal?
  
  items           InvoiceItem[]
}

// Detalle de la factura (Qué productos se llevaron)
model InvoiceItem {
  id              String   @id @default(uuid())
  quantity        Int
  
  // IMPORTANTE: Guardamos el precio AL MOMENTO de la venta.
  // Si mañana el sofá sube de precio, la factura vieja no debe cambiar.
  unitPrice       Decimal 
  
  // Para FIFO: registramos el costo total real de estos productos
  totalCost       Decimal? @default(0)

  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
}

// --------------------------------------
// COMPRAS Y PROVEEDORES
// --------------------------------------

model Supplier {
  id           String   @id @default(uuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  taxId        String?
  paymentTerms String?

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  
  // Gastos pagados a este proveedor
  expenses     Expense[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([tenantId])
  purchases    Purchase[]
}

// --------------------------------------
// FLUJO DE CAJA (CASH FLOW)
// --------------------------------------

model CashShift {
  id            String          @id @default(uuid())
  openingTime   DateTime        @default(now())
  closingTime   DateTime?
  
  initialAmount Decimal         @default(0) // Base
  finalAmount   Decimal?        // Lo que cuenta el cajero al final
  systemAmount  Decimal?        // Calculado por las ventas CASH
  difference    Decimal?        // final - system
  
  status        CashShiftStatus @default(OPEN)
  
  // Relaciones
  sellerId      String
  seller        User            @relation(fields: [sellerId], references: [id])
  
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])

  transactions  CashTransaction[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([sellerId])
}

model CashTransaction {
  id          String              @id @default(uuid())
  amount      Decimal
  reason      String
  type        CashTransactionType
  
  shiftId     String
  shift       CashShift           @relation(fields: [shiftId], references: [id])
  
  createdAt   DateTime            @default(now())
}

// --------------------------------------
// GASTOS OPERATIVOS
// --------------------------------------

enum ExpenseCategory {
  RENT          // Arriendo del local
  UTILITIES     // Servicios públicos (agua, luz, internet)
  PAYROLL       // Nómina y salarios
  SUPPLIES      // Suministros de oficina
  MAINTENANCE   // Mantenimiento y reparaciones
  TRANSPORT     // Transporte y fletes
  MARKETING     // Publicidad y marketing
  TAXES         // Impuestos
  INSURANCE     // Seguros
  OTHER         // Otros gastos
  INVENTORY     // Compra de mercancía
}

model Expense {
  id          String          @id @default(uuid())
  amount      Decimal
  description String
  category    ExpenseCategory
  date        DateTime        @default(now())  // Fecha del gasto
  
  // Opcional: Proveedor asociado
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  
  // Multi-tenancy
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  
  // Quién registró el gasto
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
  @@index([date])
}

// --------------------------------------
// COMPRAS (MÓDULO NUEVO)
// --------------------------------------

enum PurchaseStatus {
  PENDING     // Pendiente de recibir o pagar
  COMPLETED   // Completada (mercancía recibida y pagada)
  CANCELLED   // Cancelada
  PARTIAL     // Parcialmente recibida o pagada
}

model Purchase {
  id              String         @id @default(uuid())
  purchaseNumber  Int            // Consecutivo por tenant (1, 2, 3...)
  subtotal        Decimal        @default(0) // Suma de items
  additionalCosts Decimal        @default(0) // Fletes, seguros, etc.
  total           Decimal        // subtotal + additionalCosts
  status          PurchaseStatus @default(COMPLETED)
  amountPaid      Decimal        @default(0)
  isPaid          Boolean        @default(true) // Si está totalmente pagada
  notes           String?
  
  // Fechas (Importante para que tu papá vea el flujo diario)
  date            DateTime       @default(now()) 
  
  // Relaciones
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  
  buyerId         String
  buyer           User           @relation(fields: [buyerId], references: [id])
  
  warehouseId     String? // Bodega a la que entró la mercancía
  
  items           PurchaseItem[]
  payments        PurchasePayment[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
  @@index([supplierId])
  @@index([date])
}

model PurchasePayment {
  id          String   @id @default(uuid())
  amount      Decimal
  date        DateTime @default(now())
  notes       String?
  
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
}

model PurchaseItem {
  id              String   @id @default(uuid())
  quantity        Int
  costPrice       Decimal // Precio de costo AL MOMENTO de la compra
  
  purchaseId      String
  purchase        Purchase @relation(fields: [purchaseId], references: [id])
  
  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  // Relación con lotes de stock que genera esta compra (puede ser más de uno por transferencias)
  stockBatches    StockBatch[]
}

// --------------------------------------
// FIFO / LOTES DE STOCK (TRAZABILIDAD)
// --------------------------------------

model StockBatch {
  id                String    @id @default(uuid())
  
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  
  // Opcional: El lote puede venir de una compra o de un ajuste manual
  // No @unique para permitir transferencias FIFO que crean lotes hijos
  purchaseItemId   String?
  purchaseItem     PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  
  initialQuantity  Int
  remainingQuantity Int       @default(0)
  costPrice        Decimal   @default(0)
  
  entryDate        DateTime  @default(now())
  
  // Multi-tenancy
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([productId, entryDate])
  @@index([warehouseId])
}

// --------------------------------------
// AUDITORÍA / ACTIVITY LOGS
// --------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // CREATE, UPDATE, DELETE, CANCEL, TRANSFER, LOGIN, etc.
  entity      String   // Product, Invoice, Purchase, Warehouse, etc.
  entityId    String?  // ID del recurso afectado
  
  // Datos del cambio (opcional)
  oldValue    Json?    // Estado anterior (snapshot parcial)
  newValue    Json?    // Estado nuevo (snapshot parcial)
  metadata    Json?    // Datos adicionales (IP, user-agent, etc.)
  
  // Usuario que realizó la acción
  userId      String?
  userName    String?  // Snapshot del nombre para referencia rápida
  userRole    String?  // Snapshot del rol
  
  // Multi-tenancy
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// --------------------------------------
// SECUENCIAS POR TENANT (Autoincrement atómico)
// --------------------------------------

model TenantSequence {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  sequenceName  String   // 'invoice' | 'purchase'
  currentValue  Int      @default(0)

  @@unique([tenantId, sequenceName])
  @@index([tenantId])
}