      "parameters": {
        "jsCode": "const geminiRaw = $input.first().json;\nlet rawText = geminiRaw.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nrawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet decision;\ntry { decision = JSON.parse(rawText); } catch (e) { decision = { accion: 'PEDIR_INFO', query: null }; }\n\nconst ctx = $('Preparar Contexto IA').first().json;\nreturn [{ json: { ...ctx, accion: decision.accion, query: decision.query } }];"
      },
