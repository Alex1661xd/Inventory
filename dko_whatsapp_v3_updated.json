        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": { \"parts\": [{ \"text\": \"Eres el asistente virtual de DKO Mueblería. Responde amable y conciso (máx 3 líneas). Usa los datos reales del catálogo proporcionado. Si no hay productos (count 0), dilo amablemente.\" }] },\n  \"contents\": [{ \"parts\": [{ \"text\": \"Cliente: {{ $('Parsear Decisión').first().json.pushName }}\\nPregunta: {{ $('Parsear Decisión').first().json.text }}\\n\\nCatálogo:\\nTotal: {{ $json.count }}\\nProductos: {{ JSON.stringify($json.products) }}\" }] }],\n  \"generationConfig\": { \"temperature\": 0.6 }\n}"
