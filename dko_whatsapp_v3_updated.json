        1760,
        600
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const historialRaw = $input.first().json.value || null;\nlet historial = [];\ntry { if (historialRaw) historial = JSON.parse(historialRaw); } catch (e) {}\nif (historial.length > 10) historial = historial.slice(-10);\n\nconst parsed = $('Parsear Mensaje').first().json;\nconst text = parsed.text.toLowerCase().trim();\n\n// 1. FILTRO DE SEGURIDAD (Hard Rules)\nconst saludos = ['hola', 'buenos dias', 'buenas tardes', 'buenas noches', 'buenas', 'hey', 'buen dia', 'hi', 'hello', 'ola', 'buenas!', 'hola!'];\nlet forceAction = null;\n\nif (saludos.includes(text) || text.length < 3) {\n  forceAction = {\n    accion: \"PEDIR_INFO\",\n    query: null,\n    respuesta: `¡Hola ${parsed.pushName}! 👋 Bienvenido a DKO Mueblería. ¿En qué puedo ayudarte hoy? ¿Buscas algún mueble en especial o quieres consultar el estado de un pedido?`\n  };\n}\n\n// 2. SYSTEM INSTRUCTION\nconst systemInstruction = `Eres el asistente de DKO Mueblería.\nTu UNICA prioridad es clasificar la intención del usuario.\n\nREGLAS DE ORO:\n1. Si el usuario SALUDA o hace una pregunta general -> Accion: PEDIR_INFO.\n2. Si el usuario pregunta por un mueble, sofá, cama, comedor, etc -> Accion: BUSCAR_PRODUCTO.\n3. Si el usuario está enojado o pide hablar con alguien -> Accion: ESCALAR_HUMANO.\n\nEJEMPLO DE SALUDO:\nUsuario: \"Hola\" -> {\"accion\": \"PEDIR_INFO\", \"query\": null, \"respuesta\": \"¡Hola! ¿En qué puedo ayudarte?\"}`;\n\n// 3. CONSTRUCCIÓN DEL PAYLOAD\nconst geminiPayload = {\n  system_instruction: { parts: [{ text: systemInstruction }] },\n  contents: [{ parts: [{ text: `Historial: ${JSON.stringify(historial)}\\nMensaje del usuario: ${parsed.text}` }] }],\n  generationConfig: {\n    responseMimeType: \"application/json\",\n    temperature: 0.1\n  }\n};\n\nreturn [{\n  json: {\n    ...parsed,\n    historial,\n    geminiPayload,\n    forceAction\n  }\n}];"
      },
