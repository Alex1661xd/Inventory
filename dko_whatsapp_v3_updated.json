      "id": "webhook-trigger",
      "name": "Webhook Evolution API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst event = (body.event || '').toLowerCase();\n\nif (event !== 'messages.upsert') return [{ json: { skip: true, skipReason: 'event_not_supported' } }];\n\nconst data = body.data || {};\nconst key = data.key || {};\nconst message = data.message || {};\n\nif (key.fromMe || !key.remoteJid || key.remoteJid.includes('@broadcast') || key.remoteJid.includes('@g.us')) {\n  return [{ json: { skip: true, skipReason: 'invalid_sender' } }];\n}\n\nconst messageType = (data.messageType || Object.keys(message)[0] || '').trim();\nif (!['conversation', 'extendedTextMessage'].includes(messageType)) {\n  return [{ json: { skip: true, skipReason: 'invalid_type' } }];\n}\n\nconst text = (message.conversation || message.extendedTextMessage?.text || '').trim();\nif (!text) return [{ json: { skip: true, skipReason: 'empty_text' } }];\n\nconst pushName = data.pushName || body.pushName || 'Cliente';\nconst instanceName = body.instance || 'DKO-Muebles';\nconst ts = data.messageTimestamp || Math.floor(Date.now() / 1000);\nconst messageId = key.id || `${key.remoteJid}:${ts}:${text.slice(0, 32)}`;\nconst phone = key.remoteJid.replace('@s.whatsapp.net', '');\n\nreturn [{\n  json: { skip: false, phone, remoteJid: key.remoteJid, text, pushName, instanceName, messageId }\n}];"
      },
