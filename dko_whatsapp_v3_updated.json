        "jsCode": "const item = $input.first().json;\nconst historial = item.historial || [];\nhistorial.push({ role: 'user', content: item.text });\nhistorial.push({ role: 'model', content: item.responseText });\n\nreturn [{\n  json: {\n    ...item,\n    historialActualizado: historial.slice(-10),\n    evolutionPayload: { number: item.remoteJid, text: item.responseText, delay: 1000, presence: 'composing' }\n  }\n}];"
